<script type="text/javascript" src="tools/js/tipped.js"></script>
<link rel="stylesheet" type="text/css" href="tools/css/tipped.css"/>
<script>
	$(document).ready(function() {
	    Tipped.create('.item_image');
	});
</script>

{% set rank = shinobi_rank(player) %}
{% set ranks = config.naruto_shinobi_ranks %}
<div class="n-cp{% if rank %} n-cp-rank-{{ rank.id }}{% endif %}">
	{{ hook('HOOK_CHARACTERS_BEFORE_INFORMATIONS') }}

	{# ═══ HERO: identity + key numbers + rank ═══ #}
	<section class="n-cp-hero{% if player.isOnline() %} is-online{% endif %}">
		<div class="n-cp-hero-bg" style="background-image:url('{{ vocation_image(vocation) }}')"></div>

		<div class="n-cp-hero-main">
			<div class="n-cp-portrait">
				<img src="{{ vocation_image(vocation) }}" alt="{{ vocation }}">
				{% if rank %}
					<span class="n-cp-seal" title="Shinobi Rank: {{ rank.letter }} - {{ rank.name }}"><b>{{ rank.letter }}</b></span>
				{% endif %}
				{% if config.characters.outfit and outfit %}
					<img class="n-cp-outfit" src="{{ outfit }}" alt="player outfit" loading="lazy">
				{% endif %}
			</div>

			<div class="n-cp-head">
				<div class="n-cp-status">
					<span class="n-cp-dot"></span>{% if player.isOnline() %}Online{% else %}Offline{% endif %}
				</div>
				<h1 class="n-cp-name">{{ flag|raw }} {{ player.getName() }}</h1>
				{% if oldName %}<div class="n-cp-oldname">{{ oldName|raw }}</div>{% endif %}
				<p class="n-cp-sub">
					<span class="n-cp-voc">{{ vocation }}</span>
					{% if config.characters.level %}<span class="n-cp-lvl">Level <b>{{ player.getLevel() }}</b></span>{% endif %}
					{% if town %}<span class="n-cp-town">{{ town }}</span>{% endif %}
				</p>
				<div class="n-cp-badges">
					{% if guild.rank is not null %}
						<span class="n-cp-badge">{{ guild.rank }} of {{ guild.link|raw }}</span>
					{% endif %}
					<span class="n-cp-badge{% if account.isPremium() %} is-premium{% endif %}">{% if account.isPremium() %}Premium{% else %}Free{% endif %} Account</span>
					{% set group = player.getGroup() %}
					{% if group.isLoaded() and group.getId() != 1 %}
						<span class="n-cp-badge is-staff">{{ group.getName()|capitalize }}</span>
					{% endif %}
					{% if bannedUntil matches '/^\\d+$/' or bannedUntil == '-1' %}
						<span class="n-cp-badge is-banned">Banished {% if bannedUntil == '-1' %}forever{% else %}until {{ bannedUntil|date('d M Y') }}{% endif %}</span>
					{% endif %}
					{% if skull is not null %}<img class="n-cp-skull" src="images/{{ skull }}.gif" alt="skull">{% endif %}
					{% if canEdit %}
						<a class="n-cp-badge n-cp-edit" href="{{ constant('ADMIN_URL') }}?p=players&id={{ player.getId() }}" title="Edit in Admin Panel" target="_blank">Edit</a>
					{% endif %}
				</div>
			</div>

			{% if config.characters.equipment %}
				<div class="n-cp-eq" aria-label="Equipment">
					<div class="n-cp-eq-col">
						<div class="n-cp-slot">{{ equipment[2]|raw }}</div>
						<div class="n-cp-slot">{{ equipment[6]|raw }}</div>
						<div class="n-cp-slot">{{ equipment[9]|raw }}</div>
					</div>
					<div class="n-cp-eq-col">
						<div class="n-cp-slot">{{ equipment[1]|raw }}</div>
						<div class="n-cp-slot">{{ equipment[4]|raw }}</div>
						<div class="n-cp-slot">{{ equipment[7]|raw }}</div>
						<div class="n-cp-slot">{{ equipment[8]|raw }}</div>
					</div>
					<div class="n-cp-eq-col">
						<div class="n-cp-slot">{{ equipment[3]|raw }}</div>
						<div class="n-cp-slot">{{ equipment[5]|raw }}</div>
						<div class="n-cp-slot">{{ equipment[10]|raw }}</div>
					</div>
				</div>
			{% endif %}
		</div>

		{% if config.characters.experience or frags_enabled %}
		<dl class="n-cp-kpis">
			{% if config.characters.experience %}
				<div class="n-cp-kpi"><dt>Experience</dt><dd>{{ player.getExperience()|number_format(0, '.', ',') }}</dd></div>
			{% endif %}
			{% if frags_enabled %}
				<div class="n-cp-kpi"><dt>Frags</dt><dd>{{ frags_count }}</dd></div>
			{% endif %}
			<div class="n-cp-kpi"><dt>Deaths</dt><dd>{{ deaths|length }}</dd></div>
		</dl>
		{% endif %}

		{% if rank %}
			{% set lastId = ranks|keys|last %}
			{% set next = ranks[rank.id + 1] ?? null %}
			<div class="n-cp-ladder">
				<div class="n-cp-ladder-head">
					<span class="n-cp-ladder-label">Shinobi rank</span>
					<b class="n-cp-ladder-current">{{ rank.name }}</b>
					<span class="n-cp-ladder-next">
						{% if next %}Next: <b>{{ next[1] }}</b>{% else %}Highest rank reached{% endif %}
					</span>
				</div>
				<ol class="n-cp-ladder-steps" style="--steps: {{ ranks|length }}; --p: {{ lastId > 0 ? rank.id / lastId : 0 }}">
					{% for id, r in ranks %}
						<li class="n-cp-step n-cp-rank-{{ id }}{% if id < rank.id %} is-done{% elseif id == rank.id %} is-current{% endif %}">
							<span class="n-cp-step-mark">{{ r[0] }}</span>
							<span class="n-cp-step-name">{{ r[1] }}</span>
						</li>
					{% endfor %}
				</ol>
			</div>
		{% endif %}
	</section>

	{# ═══ BODY: skills (wide) + profile sheet ═══ #}
	<div class="n-cp-body">
		<div class="n-cp-col n-cp-col-main">
			{{ hook('HOOK_CHARACTERS_BEFORE_SKILLS') }}

			{% if config.characters.skills and skills %}
				{% set shown = skills %}
				{# absolute scale (config.php naruto_skill_max): bar fills toward max;
				   color = max split in 6 steps, reusing the shinobi rank palette (0=E … 6=S+) #}
				{% set skillMax = max(config.naruto_skill_max ?? 150, 1) %}
				<section class="n-cp-panel n-cp-skills-panel">
					<h2 class="n-cp-title">Skills</h2>
					<ul class="n-cp-skills">
						{% for skill in shown %}
							{% set imgName = (config.naruto_skill_image_aliases[skill.name] ?? skill.name)|lower %}
							{% set imgFile = config.naruto_skill_images[imgName] ?? null %}
							{% set tier = min((skill.value * 6 / skillMax)|round(0, 'floor'), 6) %}
							<li class="n-cp-skill n-cp-rank-{{ tier }}{% if skill.value == 0 %} is-zero{% endif %}">
								<span class="n-cp-skill-icon">
									{% if imgFile %}<img src="{{ template_path }}/images/skills/{{ imgFile|url_encode }}" alt="" loading="lazy">{% else %}<i>{{ skill.name|first|upper }}</i>{% endif %}
								</span>
								<span class="n-cp-skill-name">{{ skill.name }}</span>
								<b class="n-cp-skill-value">{{ skill.value }}</b>
								<span class="n-cp-skill-bar" style="--w: {{ min(skill.value / skillMax, 1)|round(3) }}" aria-hidden="true"></span>
							</li>
						{% endfor %}
					</ul>
				</section>
			{% endif %}

			{{ hook('HOOK_CHARACTERS_AFTER_SKILLS') }}

			{% if quests_enabled %}
				<section class="n-cp-panel">
					<h2 class="n-cp-title">Quests</h2>
					<ul class="n-cp-quests">
						{% for name, done in quests %}
							<li class="{% if done %}is-done{% endif %}">
								<span class="n-cp-check" aria-hidden="true"></span>
								{{ name }}
								<span class="n-cp-sr">{% if done %}(completed){% else %}(not completed){% endif %}</span>
							</li>
						{% endfor %}
					</ul>
				</section>
			{% endif %}

			{{ hook('HOOK_CHARACTERS_AFTER_QUESTS') }}
			{{ hook('HOOK_CHARACTERS_AFTER_EQUIPMENT') }}
		</div>
	</div>

	{# Profile section removed; plugin hooks kept #}
	{{ hook('HOOK_CHARACTERS_AFTER_INFORMATIONS') }}
	{% if not player.isHidden() %}{{ hook('HOOK_CHARACTERS_AFTER_ACCOUNT') }}{% endif %}

	{{ hook('HOOK_CHARACTERS_BEFORE_DEATHS') }}

	{# ═══ BATTLE RECORD ═══ #}
	{% if deaths|length > 0 or frags|length > 0 %}
		<div class="n-cp-record">
			{% if deaths|length > 0 %}
				<section class="n-cp-panel">
					<h2 class="n-cp-title">Deaths <small>{{ deaths|length }}</small></h2>
					<ol class="n-cp-log">
						{% for death in deaths %}
							<li><time>{{ death.time|date("j M Y, H:i") }}</time><span>{{ death.description|raw }}</span></li>
						{% endfor %}
					</ol>
				</section>
			{% endif %}
			{% if frags|length > 0 %}
				<section class="n-cp-panel">
					<h2 class="n-cp-title">Victims <small>{{ frags|length }}</small></h2>
					<ol class="n-cp-log">
						{% for frag in frags %}
							<li>
								<time>{{ frag.time|date("j M Y, H:i") }}</time>
								<span>{{ frag.description|raw }}
									{% if frag.unjustified %}<em class="n-cp-tag is-bad">Unjustified</em>{% else %}<em class="n-cp-tag is-good">Justified</em>{% endif %}
								</span>
							</li>
						{% endfor %}
					</ol>
				</section>
			{% endif %}
		</div>
	{% endif %}

	{# ═══ OTHER CHARACTERS ═══ #}
	{% if not player.isHidden() %}
		<section class="n-cp-panel n-cp-panel-flat">
			<h2 class="n-cp-title">Characters on this account</h2>
			<div class="n-cp-chars">
				{% for other in account_players %}
					{% if not other.isHidden() and (config('characters')['deleted'] or not other.isDeleted()) %}
						<a class="n-cp-char{% if other.getId() == player.getId() %} is-current{% endif %}" href="{{ getPlayerLink(other.getName(), false) }}"{% if other.getId() == player.getId() %} aria-current="page"{% endif %}>
							<img src="{{ vocation_image(other.getVocationName()) }}" alt="" loading="lazy">
							<span class="n-cp-char-info">
								<b>{{ other.getName() }}</b>
								<small>Level {{ other.getLevel() }}, {{ other.getVocationName() }}</small>
							</span>
							{% if other.isDeleted() %}<em class="n-cp-tag is-bad">Deleted</em>{% elseif other.isOnline() %}<em class="n-cp-tag is-good">Online</em>{% endif %}
						</a>
					{% endif %}
				{% endfor %}
			</div>
		</section>
	{% endif %}

	{{ hook('HOOK_CHARACTERS_AFTER_CHARACTERS') }}
	{{ hook('HOOK_CHARACTERS_BEFORE_SIGNATURE') }}

	{# ═══ SIGNATURE (collapsed by default) ═══ #}
	{% if setting('core.signature_enabled') %}
		<details class="n-cp-panel n-cp-signature">
			<summary class="n-cp-title">Signature banner</summary>
			<img src="{{ signature_url }}" alt="Signature for player {{ player.getName() }}" loading="lazy">
			<div class="n-cp-sig-links">
				<label>Website <input type="text" readonly value="<a href=&quot;{{ player_link }}&quot;><img src=&quot;{{ signature_url }}&quot;></a>" onclick="this.select()"></label>
				<label>Forum <input type="text" readonly value="[URL={{ player_link }}][IMG]{{ signature_url }}[/IMG][/URL]" onclick="this.select()"></label>
				<label>Direct link <input type="text" readonly value="{{ signature_url }}" onclick="this.select()"></label>
			</div>
		</details>
	{% endif %}

	{{ hook('HOOK_CHARACTERS_AFTER_SIGNATURE') }}
</div>

<div class="n-cp-search">{{ search_form|raw }}</div>
