<article class="n-news">
	<header class="n-news-head">
		<h2 class="n-news-title">
			<img src="{{ constant('BASE_URL') }}images/news/icon_{{ icon }}.gif" class="n-news-icon" alt="" />
			{{ title }}
		</h2>
		<div class="n-news-meta">
			<span>{{ date|date(setting('core.news_date_format')) }}</span>
			{% if setting('core.news_author') and author is not empty %}
			<span class="n-news-author">· by <strong>{{ author }}</strong></span>
			{% endif %}
		</div>
	</header>
	<div class="n-news-body">
		{{ content|raw }}
		{% if comments is not null %}
		<div class="n-news-comments"><a href="{{ comments }}">» Comment on this news</a></div>
		{% endif %}
	</div>
</article>
